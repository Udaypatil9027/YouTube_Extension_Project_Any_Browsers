{
  "manifest_version": 3,
  "name": "GestureTube - Hand Control for YouTube",
  "version": "2.0",
  "description": "Control YouTube with hand gestures - Peace sign to Play/Pause, Open palm to Skip Ads",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GestureTube"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}